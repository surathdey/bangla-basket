# Bangla Basket -- environment template (PLACEHOLDERS ONLY -- never real values).
# Copy to .env for local runs, or set these in the deployment environment.
# The Docker Compose stack reads this file; the backend service overrides
# DATABASE_URL / MINIO_ENDPOINT to the Compose service names (see below).

# --- Database (Postgres; replaces MONGO_URL / DB_NAME) ---------------------
# Inside Docker Compose the backend reaches Postgres as host "postgres".
DATABASE_URL=CHANGE_ME
# Local run without Docker: postgresql://bangla:bangla@localhost:5432/banglabasket
# (also the backend's built-in default when DATABASE_URL is unset).

# --- Auth (REQUIRED -- the backend refuses to boot without these) ----------
JWT_SECRET=CHANGE_ME
JWT_ALG=HS256
ADMIN_EMAIL=admin@bongconnekt.ca
ADMIN_PASSWORD=CHANGE_ME
# Optional reviewer seed account (only created when BOTH are set):
REVIEWER_EMAIL=
REVIEWER_PASSWORD=

# --- Public URLs ------------------------------------------------------------
PUBLIC_BASE_URL=https://banglabasket.ca
PUBLIC_WEB_URL=https://banglabasket.ca
EXPO_PUBLIC_BACKEND_URL=https://banglabasket.ca
EXPO_PACKAGER_HOSTNAME=

# --- Payments (Stripe) ------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (direct Resend; replaces EMERGENT_EMAIL_KEY) ---------------------
RESEND_API_KEY=
EMAIL_FROM=orders@bongconnekt.ca
EMAIL_FROM_NAME=Bangla Basket
EMAIL_REPLY_TO=

# --- Push (direct Expo; replaces EMERGENT_PUSH_KEY) -------------------------
# Optional: raises Expo rate limits when set. Sends work without it.
EXPO_ACCESS_TOKEN=

# --- Google -----------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
# Direct Google ID-token login (contingency path for /api/auth/session).
# Required only if the app sends {"id_token": ...} instead of the relay token.
GOOGLE_CLIENT_ID=
# Legacy Emergent Auth relay (only used when the app sends session_token).
# Leave unset to keep the built-in default; set to "" only to disable it.
# EMERGENT_AUTH_URL=

# --- Object storage (MinIO; replaces Emergent Managed Object Storage) -------
# Inside Docker Compose the backend reaches MinIO as host "minio".
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=bangla-basket

# --- Integrations (Fernet-encrypted credentials in business_settings) -------
# CRITICAL MIGRATION ITEM: INTEGRATIONS_FERNET_KEY must be carried over
# byte-for-byte from the old deployment at migration time. Without the exact
# same key, the stored Twilio / Google Drive credentials cannot be decrypted.
# This file must NEVER contain the real value.
INTEGRATIONS_FERNET_KEY=

# --- Misc -------------------------------------------------------------------
OTP_PEPPER=
APP_VARIANT=customer
UPLOADS_DIR=/app/backend/uploads

# --- LLM (admin-time menu enrichment only) ----------------------------------
# menu_ai.py still reads EMERGENT_LLM_KEY; at migration, either keep the
# Emergent key (if that account stays active) or replace menu_ai with a
# direct OpenAI/Gemini call and set the direct key here. See README.
EMERGENT_LLM_KEY=

# --- Platform hub (optional overrides; brand.json supplies defaults) --------
PLATFORM_TENANT_ID=
PLATFORM_API_KEY=
PLATFORM_STATUS_URL=
PLATFORM_POLL_SEC=

# --- REMOVED keys (do NOT re-add) -------------------------------------------
# MONGO_URL / DB_NAME -- replaced by DATABASE_URL.
# EMERGENT_EMAIL_KEY  -- replaced by RESEND_API_KEY.
# EMERGENT_PUSH_KEY   -- replaced by direct Expo Push (EXPO_ACCESS_TOKEN optional).
